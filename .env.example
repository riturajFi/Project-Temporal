# -----------------------------------------------------------------------------
# Common configuration for local development.
#
# How to use:
# 1) Copy this file to `.env`
# 2) Change values in `.env` for your machine
# 3) Run `docker compose up -d`
#
# Docker Compose auto-loads `.env` from repo root.
# -----------------------------------------------------------------------------

# Compose project name. Prefixes network/volume names to avoid collisions.
COMPOSE_PROJECT_NAME=project-temporal

# App runtime mode (used by future API/workers).
APP_ENV=local
# Log verbosity (used by future API/workers).
LOG_LEVEL=INFO

# Future API host port (for when FastAPI app is added).
API_PORT=8000
# Future UI host port (for when Next.js app is added).
UI_PORT=3000

# ------------------------------
# PostgreSQL settings
# ------------------------------

# Docker-network hostname for Postgres service.
POSTGRES_HOST=postgres
# Postgres container port inside Docker network.
POSTGRES_PORT=5432
# Postgres port exposed on your local machine.
POSTGRES_HOST_PORT=5432
# Postgres username used by all services.
POSTGRES_USER=postgres
# Postgres password used by all services.
POSTGRES_PASSWORD=postgres
# Core Postgres database created by container at first start.
POSTGRES_DB=temporal
# Additional app database created by init script.
APP_DB_NAME=app

# Connection string for tools running on your host machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# Connection string for containers talking inside Docker network.
DATABASE_URL_DOCKER=postgresql://postgres:postgres@postgres:5432/app

# ------------------------------
# Redis settings
# ------------------------------

# Docker-network hostname for Redis service.
REDIS_HOST=redis
# Redis container port inside Docker network.
REDIS_PORT=6379
# Redis port exposed on host.
REDIS_HOST_PORT=6379
# Host-based Redis URL for local tools.
REDIS_URL=redis://localhost:6379/0
# Docker-network Redis URL for containers.
REDIS_URL_DOCKER=redis://redis:6379/0

# ------------------------------
# Kafka + Zookeeper settings
# ------------------------------

# Zookeeper host port for local access.
ZOOKEEPER_HOST_PORT=2181
# Kafka internal listener port used by containers.
KAFKA_INTERNAL_PORT=9092
# Kafka host-facing listener port for local tools.
KAFKA_HOST_PORT=29092
# Hostname clients use when connecting from your machine.
KAFKA_ADVERTISED_HOST=localhost
# Auto-create topics in local dev for convenience.
KAFKA_AUTO_CREATE_TOPICS=true
# Host-based Kafka bootstrap endpoint.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# Docker-network Kafka bootstrap endpoint.
KAFKA_BOOTSTRAP_SERVERS_DOCKER=kafka:9092

# ------------------------------
# Temporal settings
# ------------------------------

# Temporal gRPC API port on host.
TEMPORAL_HOST_PORT=7233
# Temporal UI port on host.
TEMPORAL_UI_HOST_PORT=8080
# Host-based Temporal endpoint.
TEMPORAL_ADDRESS=localhost:7233
# Docker-network Temporal endpoint.
TEMPORAL_ADDRESS_DOCKER=temporal:7233
# Browser origin allowed by Temporal UI CORS.
TEMPORAL_CORS_ORIGINS=http://localhost:3000

# ------------------------------
# Optional observability ports
# ------------------------------

# Loki HTTP API host port.
LOKI_HOST_PORT=3100
# Tempo HTTP API host port.
TEMPO_HTTP_HOST_PORT=3200
# Tempo OTLP gRPC ingest host port.
TEMPO_OTLP_GRPC_HOST_PORT=4317
# Prometheus host port.
PROMETHEUS_HOST_PORT=9090
